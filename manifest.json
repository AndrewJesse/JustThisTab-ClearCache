{
  "manifest_version": 3,
  "name": "Just This Tab",
  "version": "0.1.0",
  "description": "Clear the HTTP cache for the current tab's site only. Other sites, cookies, and history are left alone.",
  "minimum_chrome_version": "96",
  "incognito": "split",
  "permissions": ["activeTab", "browsingData"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Clear cache for this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
