{
  "name": "just-this-tab-clear-cache",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension that clears cache for the current tab's origin only.",
  "type": "module",
  "scripts": {
    "build": "next build && node scripts/assemble-extension.mjs",
    "check": "node scripts/check.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
